# Copy to config.env, chmod 600, and replace every REPLACE_ME value.
OPENROUTER_API_KEY=REPLACE_ME
NEWS_LLM_MODEL=z-ai/glm-5.3-flash
NEWS_LLM_URL=https://openrouter.ai/api/v1/chat/completions
NEWS_LLM_ALLOW_REMOTE=1
NEWS_LLM_REASONING_EFFORT=low
NEWS_LLM_MAX_TOKENS=4096
NEWS_LLM_WORKERS=4
NEWS_LLM_SCHEMA_RETRIES=1

# Each hourly run examines up to this many pending articles. Already analyzed
# records are skipped, so this is capacity, not guaranteed API spend.
NEWS_HOURLY_ANALYZE_LIMIT=100
NEWS_ARTICLES_PER_SOURCE=20
NEWS_IMAGE_CANDIDATE_LIMIT=24
# Actual HTTP attempts, including retries; cached hits do not count.
NEWS_IMAGE_CANDIDATE_REQUESTS=12
NEWS_BROWSER_TIMEOUT=600
NEWS_STAGE_TIMEOUT=7200
NEWS_SKIP_BROWSER=0

# Public eval operator. Keep disabled before the pilot. The eval credential is
# deliberately separate from GOOGLE_APPLICATION_CREDENTIALS used for GCS.
NEWS_EVAL_MODE=disabled
NEWS_EVAL_ACCEPTED_MAX_AGE_HOURS=26
NEWS_EVAL_REVIEW_LIMIT=50
NEWS_EVAL_SELECTIONS_JSON=[]
NEWS_EVAL_GOOGLE_APPLICATION_CREDENTIALS=
NEWS_EVAL_OPERATOR_CLI="${DATA_BG_ROOT}/news-functions/lib/operator-cli.js"
NEWS_EVAL_LIVE_MANIFEST_URL=https://storage.googleapis.com/data-electionsbg-com/news/app-data/manifest.json

# Public upload is an explicit later cutover. Leave disabled while the news app
# and backlink pages are experimental. When enabling, use disjoint non-root
# prefixes. App data is create-only, versioned and committed by a
# generation-guarded manifest written last;
# mentions still delete stale objects within their own exact-sync prefix.
NEWS_ENABLE_PUBLIC_UPLOAD=0
NEWS_PUBLIC_GCS_URI=
NEWS_MENTIONS_GCS_URI=

# MUST be a different, private bucket: it contains full article text and
# analysis history. Archive sync never deletes remote objects, so local cleanup
# cannot erase history. Create the bucket and its IAM/lifecycle out of band.
NEWS_ARCHIVE_GCS_URI=gs://REPLACE_ME_PRIVATE_BUCKET/news/archive
NEWS_REQUIRE_ARCHIVE_VERSIONING=1

# Cron has a sparse PATH. Add a custom Cloud SDK/Homebrew location if needed.
NEWS_EXTRA_PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
