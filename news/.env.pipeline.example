# Hourly capacity and acquisition settings. Already-analyzed articles are not
# billed again; the limit is maximum queue capacity per invocation.
NEWS_HOURLY_ANALYZE_LIMIT=100
NEWS_ARTICLES_PER_SOURCE=20
NEWS_IMAGE_CANDIDATE_LIMIT=24
# At most this many Commons HTTP attempts per hour, including retries. Results,
# including empty results, are shared by articles with the same subject.
NEWS_IMAGE_CANDIDATE_REQUESTS=12
NEWS_BROWSER_TIMEOUT=600
NEWS_STAGE_TIMEOUT=7200
NEWS_SKIP_BROWSER=0

# Person-sentiment surfaces (docs/plans/news-person-sentiment-v1.md §8). Off by
# default; an off surface is not written at all, and an unreadable value
# refuses the build. RAIL: the article page's „Хора в материала" — after the
# identity join's link audit (news/evals/person_link_precision.json). AGGREGATES:
# person pages, /persons, the outlet section, the main-site tile — after
# `npm run news:person:gate:enforce`. MATRIX: the outlet × person grid, needs
# AGGREGATES. The election freeze (news/data/publication_freezes.json) applies
# whatever these say.
NEWS_PERSON_RAIL=0
NEWS_PERSON_AGGREGATES=0
NEWS_PERSON_MATRIX=0

# Cron has a sparse PATH on macOS.
NEWS_EXTRA_PATH=/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin
