# Public evals are disabled until the deliberate pilot rollout. "optional"
# permits a missing dedicated credential only before accepted overrides exist;
# "required" blocks publication when the operator or accepted snapshot is stale.
NEWS_EVAL_MODE=disabled
NEWS_EVAL_ACCEPTED_MAX_AGE_HOURS=26
NEWS_EVAL_REVIEW_LIMIT=50
# Repo/runtime-relative reproducible public selection manifests.
NEWS_EVAL_SELECTIONS_JSON=[]

# Never point this at GOOGLE_APPLICATION_CREDENTIALS from .env.upload. The
# runtime refuses that credential reuse even if both paths resolve identically.
NEWS_EVAL_GOOGLE_APPLICATION_CREDENTIALS="${NEWS_DEPLOY_ROOT}/credentials/news-eval-service-account.json"
NEWS_EVAL_OPERATOR_CLI="${NEWS_DEPLOY_ROOT}/../news-functions/lib/operator-cli.js"
NEWS_EVAL_LIVE_MANIFEST_URL=https://storage.googleapis.com/data-electionsbg-com/news/app-data/manifest.json
