# Copy to .env.model. Change this file to switch models without changing code.
NEWS_LLM_MODEL=z-ai/glm-5.3-flash
NEWS_LLM_MAX_TOKENS=4096
NEWS_LLM_TEMPERATURE=0.2
NEWS_LLM_REASONING_EFFORT=low
NEWS_LLM_THINKING=0
NEWS_LLM_WORKERS=4
NEWS_LLM_SCHEMA_RETRIES=1

# Optional proof-only free-model triage. Empty means every article uses the
# primary model above.
NEWS_LLM_TRIAGE_MODEL=
NEWS_LLM_TRIAGE_TIMEOUT=12
