# Copy to .env.model. Change this file to switch models without changing code.
NEWS_LLM_MODEL=z-ai/glm-5.3-flash
NEWS_LLM_MAX_TOKENS=4096
NEWS_LLM_TEMPERATURE=0.2
NEWS_LLM_REASONING_EFFORT=low
NEWS_LLM_THINKING=0
NEWS_LLM_WORKERS=4
NEWS_LLM_SCHEMA_RETRIES=1

# OpenRouter provider routing (comma-separated names). NextBit is excluded
# because it returned malformed JSON on Bulgarian quotations — see
# news/evals/analyze-yield-2026-09-19.md. ORDER sets a preference; fallbacks
# stay on either way.
NEWS_LLM_PROVIDER_IGNORE=NextBit
NEWS_LLM_PROVIDER_ORDER=

# Hosted-endpoint transport: seconds per request and attempts (a local model
# server keeps 300 s x 3). A request abandoned at the timeout may still be
# billed by the provider and is not in the run's meter — a small, uncounted
# cost in exchange for never stalling the stage (the 2026-09-02 run lost
# 772 s to one hung request). Stage deadline: after this many seconds the
# analyze stage stops waiting, unfinished articles stay queued for the next
# run, and the process exits at once rather than waiting on the abandoned
# calls. Keep it well above one transport budget (60 s x 2 + backoff).
NEWS_LLM_HOSTED_TIMEOUT=60
NEWS_LLM_HOSTED_ATTEMPTS=2
NEWS_ANALYZE_DEADLINE_S=1500

# Optional proof-only free-model triage. Empty means every article uses the
# primary model above.
NEWS_LLM_TRIAGE_MODEL=
NEWS_LLM_TRIAGE_TIMEOUT=12
