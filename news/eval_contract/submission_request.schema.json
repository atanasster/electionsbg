{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://electionsbg.com/schemas/news/evaluation-submission-request-v1.json",
  "title": "Public news evaluation submission request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "article_key",
    "base_task_revision",
    "content_sha256",
    "analysis_sha256",
    "idempotency_key",
    "turnstile_token",
    "evaluation"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "article_key": {
      "type": "string",
      "pattern": "^[^/]{1,253}/[^/]{1,255}$"
    },
    "base_task_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "analysis_sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{16,128}$"
    },
    "turnstile_token": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "browser_nonce": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9_-]{16,128}$"
    },
    "evaluation": { "$ref": "#/$defs/evaluation" }
  },
  "$defs": {
    "reasonCode": {
      "enum": [
        "model_missed_context",
        "model_overweighted_quote",
        "label_too_strong",
        "label_too_weak",
        "neutral_vs_not_applicable",
        "insufficient_public_context",
        "wrong_party_identity",
        "party_missing",
        "party_not_meaningful",
        "tone_misread",
        "other"
      ]
    },
    "reasonCodes": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/reasonCode" }
    },
    "leaningLabel": {
      "enum": [
        "strong_progressive",
        "progressive",
        "neutral",
        "conservative",
        "strong_conservative",
        "not_applicable"
      ]
    },
    "russiaLabel": {
      "enum": [
        "strong_pro_russia",
        "pro_russia",
        "neutral",
        "anti_russia",
        "strong_anti_russia",
        "not_applicable"
      ]
    },
    "leaningSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "evidence", "reason_codes"],
      "properties": {
        "label": {
          "anyOf": [{ "$ref": "#/$defs/leaningLabel" }, { "type": "null" }]
        },
        "evidence": { "type": ["string", "null"], "maxLength": 600 },
        "reason_codes": { "$ref": "#/$defs/reasonCodes" }
      },
      "allOf": [{ "$ref": "#/$defs/selectionConditions" }]
    },
    "russiaSelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "evidence", "reason_codes"],
      "properties": {
        "label": {
          "anyOf": [{ "$ref": "#/$defs/russiaLabel" }, { "type": "null" }]
        },
        "evidence": { "type": ["string", "null"], "maxLength": 600 },
        "reason_codes": { "$ref": "#/$defs/reasonCodes" }
      },
      "allOf": [{ "$ref": "#/$defs/selectionConditions" }]
    },
    "selectionConditions": {
      "if": {
        "properties": { "label": { "type": "null" } },
        "required": ["label"]
      },
      "then": {
        "properties": {
          "reason_codes": {
            "contains": { "const": "insufficient_public_context" }
          }
        }
      },
      "else": {
        "properties": { "evidence": { "type": "string", "minLength": 1 } }
      }
    },
    "partySelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["party", "party_id", "tone", "evidence", "reason_codes"],
      "properties": {
        "party": { "type": "string", "minLength": 1, "maxLength": 160 },
        "party_id": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 160
        },
        "tone": { "enum": ["favorable", "unfavorable", "neutral", "mixed"] },
        "evidence": { "type": "string", "minLength": 1, "maxLength": 600 },
        "reason_codes": { "$ref": "#/$defs/reasonCodes" }
      }
    },
    "removedParty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["party", "party_id", "reason_code"],
      "properties": {
        "party": { "type": "string", "minLength": 1, "maxLength": 160 },
        "party_id": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 160
        },
        "reason_code": {
          "enum": ["wrong_party_identity", "party_not_meaningful", "other"]
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leaning",
        "russia_stance",
        "parties_confirmed_complete",
        "party_tones",
        "removed_model_parties",
        "public_note"
      ],
      "properties": {
        "leaning": { "$ref": "#/$defs/leaningSelection" },
        "russia_stance": { "$ref": "#/$defs/russiaSelection" },
        "parties_confirmed_complete": { "const": true },
        "party_tones": {
          "type": "array",
          "maxItems": 30,
          "items": { "$ref": "#/$defs/partySelection" }
        },
        "removed_model_parties": {
          "type": "array",
          "maxItems": 30,
          "items": { "$ref": "#/$defs/removedParty" }
        },
        "public_note": { "type": ["string", "null"], "maxLength": 600 }
      }
    }
  }
}
