# Copy to .env.upload. Keep the JSON key inside credentials/ so one secure
# copy of the news folder carries all machine-specific configuration.
GOOGLE_APPLICATION_CREDENTIALS="${NEWS_DEPLOY_ROOT}/credentials/gcs-service-account.json"
NEWS_GCS_ACTIVATE_SERVICE_ACCOUNT=1

# Full articles and analyses. Must be a private, versioned bucket.
NEWS_ARCHIVE_GCS_URI=gs://REPLACE_ME_PRIVATE_BUCKET/news/archive
NEWS_REQUIRE_ARCHIVE_VERSIONING=1

# Derived public JSON stays disabled until the deliberate site cutover.
NEWS_ENABLE_PUBLIC_UPLOAD=0
NEWS_PUBLIC_GCS_URI=
NEWS_MENTIONS_GCS_URI=
