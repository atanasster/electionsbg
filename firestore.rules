rules_version = '2';

// Firestore is written ONLY by trusted Admin SDK code. This same deny-all file
// is deployed to elections-bg and electionsbg-news; the public news evaluator
// reaches Firestore through the newsEvals Function, never through a client SDK.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
