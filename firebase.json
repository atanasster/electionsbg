{
  "projects": {
    "default": "elections-bg"
  },
  "emulators": {
    "hosting": {
      "port": 5002
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  },
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "target": "main",
      "public": "dist",
      "trailingSlash": false,
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "**/.DS_Store",
        "procurement/*.json",
        "procurement/**/*.json"
      ],
      "redirects": [
        {
          "source": "/index",
          "destination": "/",
          "type": 301
        },
        {
          "source": "/en/index",
          "destination": "/en",
          "type": 301
        }
      ],
      "rewrites": [
        {
          "source": "/api/scenarios",
          "function": {
            "functionId": "scenarios",
            "region": "us-central1"
          }
        },
        {
          "source": "/api/scenarios/**",
          "function": {
            "functionId": "scenarios",
            "region": "us-central1"
          }
        },
        {
          "source": "/api/db/**",
          "function": {
            "functionId": "db",
            "region": "europe-west3"
          }
        },
        {
          "source": "/api/sql/**",
          "function": {
            "functionId": "sql",
            "region": "europe-west3"
          }
        },
        {
          "source": "/funds/contract/**",
          "function": {
            "functionId": "db",
            "region": "europe-west3"
          }
        },
        {
          "source": "/funds/interreg/**",
          "function": {
            "functionId": "db",
            "region": "europe-west3"
          }
        },
        {
          "source": "/en/funds/contract/**",
          "function": {
            "functionId": "db",
            "region": "europe-west3"
          }
        },
        {
          "source": "/en/funds/interreg/**",
          "function": {
            "functionId": "db",
            "region": "europe-west3"
          }
        },
        {
          "source": "/company/**",
          "function": {
            "functionId": "db",
            "region": "europe-west3"
          }
        },
        {
          "source": "/en/company/**",
          "function": {
            "functionId": "db",
            "region": "europe-west3"
          }
        },
        {
          "source": "/officials/assets",
          "destination": "/officials/assets/index.html"
        },
        {
          "source": "/officials/assets/",
          "destination": "/officials/assets/index.html"
        },
        {
          "source": "/en/officials/assets",
          "destination": "/en/officials/assets/index.html"
        },
        {
          "source": "/en/officials/assets/",
          "destination": "/en/officials/assets/index.html"
        },
        {
          "source": "/officials/*",
          "function": {
            "functionId": "db",
            "region": "europe-west3"
          }
        },
        {
          "source": "/en/officials/*",
          "function": {
            "functionId": "db",
            "region": "europe-west3"
          }
        },
        {
          "source": "/person/*",
          "function": {
            "functionId": "db",
            "region": "europe-west3"
          }
        },
        {
          "source": "/en/person/*",
          "function": {
            "functionId": "db",
            "region": "europe-west3"
          }
        },
        {
          "source": "/en/**",
          "destination": "/en/index.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.json",
          "headers": [
            {
              "key": "Content-Type",
              "value": "application/json; charset=utf-8"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400, stale-while-revalidate=604800"
            }
          ]
        },
        {
          "source": "**/assets/**/*.@(js|css)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/*.@(svg|png|jpg|jpeg|webp|woff2|ttf|ico)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=2592000"
            }
          ]
        },
        {
          "source": "**/*.md",
          "headers": [
            {
              "key": "Content-Type",
              "value": "text/markdown; charset=utf-8"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400, stale-while-revalidate=604800"
            }
          ]
        },
        {
          "source": "**/llms*.txt",
          "headers": [
            {
              "key": "Content-Type",
              "value": "text/plain; charset=utf-8"
            },
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400, stale-while-revalidate=604800"
            }
          ]
        },
        {
          "source": "/funds/contract/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
            }
          ]
        },
        {
          "source": "/funds/interreg/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
            }
          ]
        },
        {
          "source": "/en/funds/contract/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
            }
          ]
        },
        {
          "source": "/en/funds/interreg/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
            }
          ]
        },
        {
          "source": "/company/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
            }
          ]
        },
        {
          "source": "/en/company/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
            }
          ]
        },
        {
          "source": "/officials/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
            }
          ]
        },
        {
          "source": "/en/officials/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
            }
          ]
        },
        {
          "source": "/person/**",
          "headers": [
            {
              "key": "Cache-Control",
              "comment": "Unlike the /officials, /company and /funds entries above, this glob covers a large STATICALLY served family: 25,167 prerendered person pages the db function never sees, plus the ~101k it does. Function responses override this with their own header, so the value here is the one PRERENDERED pages hand to browsers — which is why it carries no browser max-age. `npm run deploy` replaces dist/, deleting the previous /assets/index-<hash>.js, and main.tsx's stale-chunk recovery only listens for dynamic-import failures: if the ENTRY bundle 404s no JS runs at all, so a browser-cached person page across a deploy is an unrecoverable white screen. s-maxage keeps the CDN caching (it is purged on deploy); must-revalidate keeps the browser asking.",
              "value": "public, max-age=0, s-maxage=3600, must-revalidate"
            }
          ]
        },
        {
          "source": "/en/person/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=0, s-maxage=3600, must-revalidate"
            }
          ]
        },
        {
          "source": "/api/db/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=600"
            }
          ]
        },
        {
          "source": "/api/db/tender-document",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-store"
            }
          ]
        }
      ],
      "predeploy": [
        "[ -n \"$SKIP_PREDEPLOY\" ] || npm --prefix \"$RESOURCE_DIR\"\"/..\" run lint",
        "[ -n \"$SKIP_PREDEPLOY\" ] || npm --prefix \"$RESOURCE_DIR\"\"/..\" run budget:test",
        "[ -n \"$SKIP_PREDEPLOY\" ] || npm --prefix \"$RESOURCE_DIR\"\"/..\" run ai:test",
        "[ -n \"$SKIP_PREDEPLOY\" ] || npm --prefix \"$RESOURCE_DIR\"\"/..\" run build"
      ]
    },
    {
      "target": "ai",
      "public": "dist-ai",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "**/.DS_Store"
      ],
      "rewrites": [
        {
          "source": "/api/llm",
          "function": {
            "functionId": "llm",
            "region": "us-central1"
          }
        },
        {
          "source": "/evals",
          "destination": "/evals.html"
        },
        {
          "source": "/tools",
          "destination": "/tools.html"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0, must-revalidate"
            }
          ]
        },
        {
          "source": "**/assets/**/*.@(js|css|wasm)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/*.@(svg|png|ico|woff2|webmanifest)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=2592000"
            }
          ]
        }
      ],
      "predeploy": [
        "[ -n \"$SKIP_PREDEPLOY\" ] || npm --prefix \"$RESOURCE_DIR\"\"/..\" run build:ai"
      ]
    }
  ]
}
